{
  "name": "semantic-claims",
  "version": "0.1.0-alpha.5",
  "description": "Validate and explore Semantic Claim documents and their executable proofs.",
  "license": "MIT",
  "author": "Henry Ivry",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hejhi/semantic-claims.git"
  },
  "homepage": "https://github.com/hejhi/semantic-claims#readme",
  "bugs": {
    "url": "https://github.com/hejhi/semantic-claims/issues"
  },
  "bin": {
    "semantic-claims": "scripts/check-semantics.mjs"
  },
  "files": [
    ".agents/skills/semantic-claims",
    "EXAMPLES.md",
    "FAQ.md",
    "JAVASCRIPT.md",
    "OVERVIEW.md",
    "REFERENCE.md",
    "assets/semantic-explorer.png",
    "scripts/check-semantics.mjs",
    "scripts/check-semantics/parse.mjs",
    "scripts/check-semantics/repository.mjs",
    "scripts/check-semantics/typescript.mjs",
    "scripts/check-semantics/validate.mjs",
    "scripts/skill-management.mjs",
    "scripts/semantic-explorer/model.mjs",
    "scripts/semantic-explorer/render.mjs",
    "scripts/semantic-explorer/server.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "check:semantics": "bun scripts/check-semantics.mjs",
    "check:invariants": "bun scripts/check-semantics.mjs invariants",
    "check:scenarios": "bun scripts/check-semantics.mjs scenarios",
    "check:prerelease": "bun test && bun run test:package && git diff --check HEAD",
    "preview:explorer": "bun scripts/semantic-explorer/preview.mjs",
    "sync:skills": "bun scripts/sync-skills.mjs",
    "test": "bun test",
    "test:package:node22": "npm exec --yes --package=node@22 -- node scripts/package-smoke.mjs --expected-node=22",
    "test:package": "bun run test:package:node22"
  },
  "dependencies": {
    "typescript": "7.0.2",
    "yaml": "^2.9.0"
  }
}
